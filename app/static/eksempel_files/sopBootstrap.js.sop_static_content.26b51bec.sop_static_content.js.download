/**
 * JavaScript-File for the sopBootstrap.tag
 */

var DATE_PATTERNS = new Array();
var DATE_PATTERNS_WITH_SEARCH = new Array();

// JanJa 25 -> install listener to avoid back/forward cache uses (from 2025 chrome might ignore no-cache headers on back/forward navigation and use bfcache anyway!)
(() => {
	if (window.__BACK_FORWARD_RELOAD_INSTALLED__)
		return;
	window.__BACK_FORWARD_RELOAD_INSTALLED__ = true;
	addEventListener('pageshow', (e) => {
		if (e.persisted)
			location.reload();
	});
})();

initDateValidation();

/*
 * If one open card is found all Cards are collapsed, otherwise all cards are opened
 *
 */
function toggleAllCollapsibleCards()
{
	var hasOpenCards = false;
	var myCollapsibles = $(".bt-collapsible-card a[data-bs-toggle='collapse']");
	myCollapsibles.each(function(){
		if(!$(this).hasClass("collapsed"))
		{
			hasOpenCards = true;
		}
	});
	if(hasOpenCards)
		hideAllCollapsibleCards();
	else
		showAllCollapsibleCards();
}

/*
 * Collapses all cards which are found
 *
 */
function hideAllCollapsibleCards()
{
	var myCollapsibles = $(".bt-collapsible-card a[data-bs-toggle='collapse']");
	myCollapsibles.each(function(){
		var oneId = $(this).attr("href").substring(1);
		bootstrap.Collapse.getOrCreateInstance($('#' + oneId), {
			toggle: false
		}).hide();
	});
}

/*
 * Openes all cards which are found 
 *
 */ 
function showAllCollapsibleCards()
{
	var myCollapsibles = $(".bt-collapsible-card a[data-bs-toggle='collapse']");
	myCollapsibles.each(function(){
		var oneId = $(this).attr("href").substring(1);
		bootstrap.Collapse.getOrCreateInstance($('#' + oneId)).show();
	});
}

/*
 * If one open marked card is found all marked Cards are collapsed, otherwise all marked cards are opened
 *
 */
function toggleAllMarkedCollapsibleCards(groupName)
{
	var hasOpenCards = false;
	var myCollapsibles = $(".bt-collapsible-card a." + groupName);
	myCollapsibles.each(function(){
		if(!$(this).hasClass("collapsed"))
		{
			hasOpenCards = true;
		}
	});
	if(hasOpenCards)
		hideAllMarkedCollapsibleCards(groupName);
	else
		showAllMarkedCollapsibleCards(groupName);
}

/*
 * Collapses all marked cards which are found
 *
 */
function hideAllMarkedCollapsibleCards(groupName)
{
	var myCollapsibles = $(".bt-collapsible-card a." + groupName);
	myCollapsibles.each(function(){
		var oneId = $(this).attr("href").substring(1);
		bootstrap.Collapse.getOrCreateInstance($('#' + oneId), {
			toggle: false
		}).hide();
	});
}

/*
 * Openes all marked cards which are found 
 *
 */ 
function showAllMarkedCollapsibleCards(groupName)
{
	var myCollapsibles = $(".bt-collapsible-card a." + groupName);
	myCollapsibles.each(function(){
		var oneId = $(this).attr("href").substring(1);
		bootstrap.Collapse.getOrCreateInstance($('#' + oneId)).show();
	});
}


function showOneCollapsibleCard(href)
{
	$('a[href="' + href + '"]').removeClass("collapsed");
	$(href).addClass("show");
}

function hideOneCollapsibleCard(href)
{
	$('a[href="' + href + '"]').addClass("collapsed");
	$(href).removeClass("show");
}

function showQuickMessage(type="", title="", message="")
{
	var myQuickMessage = $(".bt-quick-message div[role='alert']");
	var id = myQuickMessage.attr("id");
	const possibleTypes = ["success", "danger", "warning", "info"];
	
	if(possibleTypes.includes(type))
	{
		var icon = "fa-fw text-secondary me-2 ";
		if(type == "info")
			icon += "fa-solid fa-circle-info";
		else if(type == "danger")
			icon += "fa-solid fa-circle-exclamation";
		else if(type == "warning")
			icon+= "fa-solid fa-triangle-exclamation";
		else 
			icon += "fa-solid fa-circle-check";
		myQuickMessage.find("i").removeClass().addClass(icon);
		
		if(type == "info")
			type = "secondary";
		myQuickMessage.find(".toast-header").removeClass().addClass("toast-header bg-" + type);
	}
	
	if(title)
	{
		myQuickMessage.find("strong").text(title);
	}
	
	if(message)
	{
		myQuickMessage.find(".toast-body").find("span").html(message);
	}
	
	bootstrap.Toast.getOrCreateInstance($('#' + id)).show();
}

function hideQuickMessage()
{
	var myQuickMessage = $(".bt-quick-message div[role='alert']");
	var id = myQuickMessage.attr("id");
	bootstrap.Toast.getOrCreateInstance($('#' + id)).hide();
}

function initPasswordPeek()
{
	$(document).on("mousedown", ".bt-input-wrapper .show-password", function() {
		$("#" + $(this).attr("data-rel")).attr("type", "text");
		$(this).removeClass("fa-eye").addClass("fa-eye-slash");
	});
	$(document).on("mouseup", ".bt-input-wrapper .show-password", function() {
		$("#" + $(this).attr("data-rel")).attr("type", "password");
		$(this).removeClass("fa-eye-slash").addClass("fa-eye");
	});
}
function initPopovers()
{
	// activate all bootstrap popovers
	var popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'))
	var popoverList = popoverTriggerList.map(function (popoverTriggerEl) {
	  return bootstrap.Popover.getOrCreateInstance(popoverTriggerEl)
	});
}

function changeModalTitle(id, title)
{
	$('#' + id).find('.modal-title').text(title);
}

function showModal(id)
{
	bootstrap.Modal.getOrCreateInstance($('#' + id)).show();
}

function hideModal(id)
{
	bootstrap.Modal.getOrCreateInstance($('#' + id)).hide();
}

function hideAllModals()
{
	$('.bt-modal').each(function(){
		bootstrap.Modal.getOrCreateInstance($('#' + $(this).attr('id'))).hide();
	});
}

function switchLanguageFromMenu(language) {
	var currentParameters = window.location.search;
	var indexOfSprache = currentParameters.indexOf("sprache=");
	if (indexOfSprache > 0) {
		// Parameter kommt vor
		var indexOfAmpersand = currentParameters.indexOf("&", indexOfSprache)

		if (indexOfAmpersand > -1) {
			currentParameters = currentParameters.replace(currentParameters.substring(indexOfSprache, indexOfAmpersand), "sprache=" + language);
		} else {
			currentParameters = currentParameters.replace(currentParameters.substring(indexOfSprache), "sprache=" + language);
		}
	} else if (currentParameters.indexOf("?") > -1) {
		currentParameters += "&sprache=" + language;
	} else {
		currentParameters = "?sprache=" + language;
	}

	window.location.replace(window.location.pathname + currentParameters);
}


/**
 * Erhält einen Selector für eine Combobox (Select) und sortiert die Options im Select nach ihrem Key
 *
 *
 */
function orderComboboxOptionsByKey(selector) {
    // Das Select-Element anhand des übergebenen Selektors auswählen
    var select = document.querySelector(selector);

    // Die Options des Select-Elements in ein Array umwandeln
    var options = Array.from(select.options);

    // Das Array der Options nach den Werten sortieren
    options.sort(function(a, b) {
        if (a.value === null) return -1;
        if (b.value === null) return 1;

        var aValue = a.value.toLowerCase();
        var bValue = b.value.toLowerCase();

        if (aValue < bValue) return -1;
        if (aValue > bValue) return 1;
        return 0;
    });

    // Alle Options aus dem Select-Element entfernen
    while (select.options.length > 0) {
        select.remove(0);
    }

    // Die sortierten Options wieder hinzufügen
    options.forEach(function(option) {
        select.add(option);
    });
}

/**
 * Erhält einen Selector für eine Combobox (Select) und sortiert die Options im Select nach ihrem Value (Text)
 *
 *
 */
function orderComboboxOptionsByValue(selector) {
    // Das Select-Element anhand des übergebenen Selektors auswählen
    var select = document.querySelector(selector);

    // Die Options des Select-Elements in ein Array umwandeln
    var options = Array.from(select.options);

    // Das Array der Options nach dem Text sortieren
    options.sort(function(a, b) {
        if (a.value === null || a.value === '') return -1;
        if (b.value === null || b.value === '') return 1;

        var aText = a.text.toLowerCase();
        var bText = b.text.toLowerCase();

        if (aText < bText) return -1;
        if (aText > bText) return 1;
        return 0;
    });

    // Alle Options aus dem Select-Element entfernen
    while (select.options.length > 0) {
        select.remove(0);
    }

    // Die sortierten Options wieder hinzufügen
    options.forEach(function(option) {
        select.add(option);
    });
}

// ensures that input is a valid integer
function onInputIntegerCheck(input) {
	let value = $(input).val();

	if(!value)
		return;

	let integer = parseInt(value);
	if(isNaN(integer)) {
		$(input).val("");
	} else {
		$(input).val(integer);
	}
}

// if we do not have sopScript.js, we can define the loading frame functions here so that we don't have to call them on the parent frame manually
$(document).ready(function () {
	if (typeof activateGlobalLoadingFrame !== 'function') {
		window.activateGlobalLoadingFrame = function (text, fromMenu, withDelay, disableCancelButton) {
			try {
				if (!parent || parent === window || typeof parent.activateGlobalLoadingFrame !== 'function' || parent.activateGlobalLoadingFrame === window.activateGlobalLoadingFrame) {
					console.warn('activateGlobalLoadingFrame not defined in parent frame');
					return;
				}
				parent.activateGlobalLoadingFrame(text, fromMenu, withDelay, disableCancelButton, false);
			} catch (e) {
				console.warn('Error calling activateGlobalLoadingFrame in parent frame:', e);
			}
		};
	}
	if (typeof deactivateGlobalLoadingFrame !== 'function') {
		window.deactivateGlobalLoadingFrame = function () {
			try {
				if (!parent || parent === window || typeof parent.deactivateGlobalLoadingFrame !== 'function' || parent.deactivateGlobalLoadingFrame === window.deactivateGlobalLoadingFrame) {
					console.warn('deactivateGlobalLoadingFrame not defined in parent frame');
					return;
				}
				parent.deactivateGlobalLoadingFrame();
			} catch (e) {
				console.warn('Error calling deactivateGlobalLoadingFrame in parent frame:', e);
			}
		};
	}
});

function windowCanBeClosedByJs() {
	try {
		return !!window.opener || window.history.length === 1;
	} catch (ignore) {
		return false;
	}
}

function tryToRemoveFancyBoxPadding() {
	//try to remove fancybox padding
	try {
		let width = $('#fancybox-content', window.parent.document).css("width").split("px")[0];
		$('#fancybox-content', window.parent.document).css("border-width", "0px");
		$('#fancybox-wrap', window.parent.document).css("width", width + "px");
		parent.jQuery.fancybox.resize();
		parent.jQuery.fancybox.center();
	} catch {
		// we tried
	}
}

function toggleDeferComboboxLoading(_this, name)
{
	let isActivateLoading = !_this.hasClass('bt-is-defer-loaded');
	
	if(isActivateLoading)
	{
		$('#spinner-' + name).appendTo(_this.find('.filter-option'));
		$('#spinner-' + name).show();
		
		_this.find('.filter-option-inner-inner').hide();

		_this.addClass('bt-is-defer-loaded');
	}
	else
	{
		$('#spinner-' + name).hide();
	}
}

function getApexChartWidth(className)
{
	let width = $('.' + className).width();
	return width;
}

function isSelectPickerDropdownShown(element)
{
	return $(element).next('button.dropdown-toggle').hasClass('show');
}

function initDateValidation()
{
	DATE_PATTERNS[0] = /^\d\d?[\-\/\.\,\*\+\ ]+\d\d?[\-\/\.\,\*\+\ ]+\d\d?$/;
	DATE_PATTERNS[1] = /^\d\d?[\-\/\.\,\*\+\ ]+\d\d?[\-\/\.\,\*\+\ ]+\d\d\d\d$/;
	DATE_PATTERNS[2] = /^\d\d\d\d?[\-\/\.\,\*\+\ ]+\d\d?[\-\/\.\,\*\+\ ]+\d\d?$/;
	DATE_PATTERNS[3] = /^\d\d\d\d\d\d$/;
	DATE_PATTERNS[4] = /^\d\d\d\d\d\d\d\d$/;
	
	DATE_PATTERNS_WITH_SEARCH[0] = /^\d\d?[\-\/\.\,\*\+\ ]+\d\d?[\-\/\.\,\*\+\ ]+\d\d?$/;
	DATE_PATTERNS_WITH_SEARCH[1] = /^\d\d?[\-\/\.\,\*\+\ ]+\d\d?[\-\/\.\,\*\+\ ]+\d\d\d\d$/;
	DATE_PATTERNS_WITH_SEARCH[2] = /^\d\d\d\d?[\-\/\.\,\*\+\ ]+\d\d?[\-\/\.\,\*\+\ ]+\d\d?$/;
	DATE_PATTERNS_WITH_SEARCH[3] = /^\d\d\d\d\d\d$/;
	DATE_PATTERNS_WITH_SEARCH[4] = /^\d\d\d\d\d\d\d\d$/;
	DATE_PATTERNS_WITH_SEARCH[5] = /^[\>\<\>=\<=]+\d\d?[\-\/\.\,\*\+\ ]+\d\d?[\-\/\.\,\*\+\ ]+\d\d?$/;
	DATE_PATTERNS_WITH_SEARCH[6] = /^[\>\<\>=\<=]+\d\d?[\-\/\.\,\*\+\ ]+\d\d?[\-\/\.\,\*\+\ ]+\d\d\d\d$/;
	DATE_PATTERNS_WITH_SEARCH[7] = /^[\>\<\>=\<=]+\d\d\d\d?[\-\/\.\,\*\+\ ]+\d\d?[\-\/\.\,\*\+\ ]+\d\d?$/;
	DATE_PATTERNS_WITH_SEARCH[8] = /^[\>\<\>=\<=]+\d\d\d\d\d\d$/;
	DATE_PATTERNS_WITH_SEARCH[9] = /^[\>\<\>=\<=]+\d\d\d\d\d\d\d\d$/;
}

// functions for date input
function date_onBlur(field, spracheDateFormat, allowedSearchCharacters)
{
	if (field.value === '') return true;

	if (!dateIsValid(field, allowedSearchCharacters, spracheDateFormat)) {
		field.value = "";
		field.focus();
		return false;
	}

	dateFormat(field, allowedSearchCharacters, spracheDateFormat);
	return true;
}

function dateIsValid(field, allowedSearchCharacters, spracheDateFormat)
{
	if (field.value.length === 0) return true;

	const patterns = allowedSearchCharacters
	  ? VALID_DATE_PATTERNS_WITH_SEARCH
	  : VALID_DATE_PATTERNS;
	  
	if (!dateHasValidPattern(field, patterns)) return false;

	const config = {
		de: { getParts: dateGetParts,    order: [2, 1, 0] }, // TT.MM.JJJJ
		en: { getParts: dateGetParts,    order: [2, 1, 0] }, // TT/MM/JJJJ
		us: { getParts: dateGetPartsUs, order: [2, 0, 1] }, // MM-TT-JJJJ
		gl: { getParts: dateGetPartsGl, order: [2, 0, 1] }, // MM/TT/JJJJ
		se: { getParts: dateGetPartsSe, order: [0, 1, 2] }  // JJJJ-MM-TT
	};

	const format = config[spracheDateFormat] || config["en"]; // fallback auf "en"

	const parts = format.getParts(field, allowedSearchCharacters);
	if (!parts || parts.length < 3) return false;

	const [yearIdx, monthIdx, dayIdx] = format.order;
	return isDate(parts[yearIdx], parts[monthIdx], parts[dayIdx]);
}
function dateHasValidPattern(field, patterns)
{	
	var value = field.value;
	var i;
	
	for(i=0; i < patterns.length; i++)
	{ 
		if (patterns[i].test(value) == true)
			break;
	}
	if (i == patterns.length) 
		return false; 
	return true;
}
function dateGetParts(field,allowedSearchCharacters)
{
	var parts;
	var value = field.value;
	var DATE_SPLIT = /[\-\/\.\,\*\+\ ]/;
	
	if (DATE_SPLIT.test(value) && !allowedSearchCharacters) parts = value.split(DATE_SPLIT);
	else if(DATE_SPLIT.test(value))
	{
		parts = value.split(DATE_SPLIT);
		if(parts[0].search(/\d/) > 0){
			parts[3] = parts[0].substring(0,parts[0].search(/\d/));
			parts[0] = parts[0].substring(parts[0].search(/\d/));
		}
	}
	else
	{
		parts = new Array();
		// allowedcharacters wegschneiden und als letztes element ins array packen
		if(allowedSearchCharacters && value.search(/\d/) > 0){
			parts[3] = value.substring(0,value.search(/\d/));
			value = value.substring(value.search(/\d/));
		}
		parts[0] = value.substring(0,2);
		parts[1] = value.substring(2,4);
		parts[2] = value.substring(4);
	}
	if (parts[2].length < 4)
	{
	 if(parts[2] < 40) 
		 parts[2] = "20"+parts[2];
	 else
		 parts[2] = "19"+parts[2];
	}
	if (parts[2] < 1900)
		return false;
	else
		return parts;
}
function dateGetPartsUs(field,allowedSearchCharacters)
{
	var parts;
	var value = field.value;
	var DATE_SPLIT = /[\-\/\.\,\*\+\ ]/;
	
	if (DATE_SPLIT.test(value)) parts = value.split(DATE_SPLIT);
	else
	{
		parts = new Array();
		// allowedcharacters wegschneiden und als letztes element ins array packen
		if(allowedSearchCharacters && value.search(/\d/) > 0)
		{
			parts[3] = value.substring(0,value.search(/\d/));
			value = value.substring(value.search(/\d/));
		}
		if(value.length==6)
		{
			parts[0] = value.substring(0,2);
			parts[1] = value.substring(2,4);
			parts[2] = value.substring(4);
		}
		else
		{
			parts[0] = value.substring(0,2);
			parts[1] = value.substring(2,4);
			parts[2] = value.substring(4);
		}
	}
	if (parts[2].length < 4)
	{
	 if(parts[2] < 40) 
		 parts[2] = "20"+parts[2];
	 else
		 parts[2] = "19"+parts[2];
	}
	if (parts[2] < 1900)
		return false;
	else
		return parts;
}
function dateGetPartsGl(field,allowedSearchCharacters)
{
	var parts;
	var value = field.value;
	var DATE_SPLIT = /[\-\/\.\,\*\+\ ]/;
	
	if (DATE_SPLIT.test(value)) parts = value.split(DATE_SPLIT);
	else
	{
		parts = new Array();
		// allowedcharacters wegschneiden und als letztes element ins array packen
		if(allowedSearchCharacters && value.search(/\d/) > 0)
		{
			parts[3] = value.substring(0,value.search(/\d/));
			value = value.substring(value.search(/\d/));
		}
		if(value.length==6)
		{
			parts[0] = value.substring(0,2);
			parts[1] = value.substring(2,4);
			parts[2] = value.substring(4);
		}
		else
		{
			parts[0] = value.substring(0,2);
			parts[1] = value.substring(2,4);
			parts[2] = value.substring(4);
		}
	}
	if (parts[2].length < 4)
	{
	 if(parts[2] < 40) 
		 parts[2] = "20"+parts[2];
	 else
		 parts[2] = "19"+parts[2];
	}
	if (parts[2] < 1900)
		return false;
	else
		return parts;
}
function dateGetPartsSe(field,allowedSearchCharacters)
{
	var parts;
	var value = field.value;
	var DATE_SPLIT = /[\-\/\.\,\*\+\ ]/;
	
	if (DATE_SPLIT.test(value)) parts = value.split(DATE_SPLIT);
	else
	{
		parts = new Array();
		// allowedcharacters wegschneiden und als letztes element ins array packen
		if(allowedSearchCharacters && value.search(/\d/) > 0){
			parts[3] = value.substring(0,value.search(/\d/));
			value = value.substring(value.search(/\d/));
		}
		if(value.length==6)
		{
			parts[0] = value.substring(0,2);
			parts[1] = value.substring(2,4);
			parts[2] = value.substring(4);
		}
		else
		{
			parts[0] = value.substring(0,4);
			parts[1] = value.substring(4,6);
			parts[2] = value.substring(6);
		}
	}
	if (parts[0].length < 4)
	{
	 if(parts[0] < 40) 
		 parts[0] = "20"+parts[0];
	 else
		 parts[0] = "19"+parts[0];
	}
	if (parts[0] < 1900)
		return false;
	else
		return parts;
}

function dateFormat(field,allowedSearchCharacters,spracheDateFormat)
{
	var config = {
		de: { separator: ".", getParts: dateGetParts },
		en: { separator: "/", getParts: dateGetParts },
		us: { separator: "-", getParts: dateGetPartsUs },
		gl: { separator: "/", getParts: dateGetPartsGl },
		se: { separator: "-", getParts: dateGetPartsSe }
	};
	
	var format = config[spracheDateFormat];
	
	if (!format) {
		console.warn("Unbekanntes Datumsformat:", spracheDateFormat);
		format = config["en"]; // fallback auf englisches Format
	}
	
	var parts = format.getParts(field, allowedSearchCharacters);
	
	if (parts.length < 3) {
		console.warn("Ungültige Datums-Teile:", parts);
		field.value = "";
		return;
	}
	
	field.value = (allowedSearchCharacters && parts.length > 3 ? parts[3] : "") +
		fillWithNull(parts[0], 2) +
		format.separator +
		fillWithNull(parts[1], 2) +
		format.separator +
		parts[2];
}

function fillWithNull(value, fillLength)
{
	while(value.length < fillLength)
	{
		value = "0" + value;
	}
	return value;
}
function isDate(year,month,day)
{
	var daysInMonth = new Array();
	daysInMonth[1] = 31;
	daysInMonth[2] = 29;
	daysInMonth[3] = 31;
	daysInMonth[4] = 30;
	daysInMonth[5] = 31;
	daysInMonth[6] = 30;
	daysInMonth[7] = 31;
	daysInMonth[8] = 31;
	daysInMonth[9] = 30;
	daysInMonth[10] = 31;
	daysInMonth[11] = 30;
	daysInMonth[12] = 31;

	if (! isYear(year,true)) { return false; }
	if (! isMonth(month,true)) { return false; }
	if (! isDay(day,true)) { return false; }

	var intYear = parseInt(year, 10);
	var intMonth = parseInt(month, 10);
	var intDay = parseInt(day, 10);

	if (intDay > daysInMonth[intMonth]) return false;
	if ((intMonth == 2) && (intDay > daysInFebruary(intYear))) return false;

	function daysInFebruary (year)
	{
		return ( ((year % 4 == 0) && ( (!(year % 100 == 0)) ||
							(year % 400 == 0) ) ) ? 29 : 28 );
	}

	return true;
}

function isYear (s, required)
{
	if (! required && isWhiteSpace(s)) return true;
	if (! isInteger(s, true)) return false;
	if (s > 99 && s < 1000) return false;
	if (s < 1 || s > 9999) return false;

	return true;
}

function isMonth (s, required)
{
	if (! required && isWhiteSpace(s)) return true;
	if (! isInteger(s, true)) return false;
	if (s < 1 || s > 12) return false;

	return true;
}
function isDay (s, required)
{
	if (! required && isWhiteSpace(s)) return true;
	if (! isInteger(s, true)) return false;
	if (s < 1 || s > 31) return false;

	return true;
}
function isInteger (s, required)
{
	if (! required && isWhiteSpace(s)) return true;

	return reInteger.test(s)
}
function isWhiteSpace (s)
{
	return (isEmpty(s) || reWhiteSpace.test(s));
}
function isEmpty(wert)
{
	return ((wert == null) || (wert.length == 0))
}
