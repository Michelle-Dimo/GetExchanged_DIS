function getDateFormatFromSprache(sprache)
{
	if (sprache === "de")
		return "DD.MM.YYYY";
	else if (sprache === "en")
		return "DD/MM/YYYY";
	else if (sprache === "se")
		return "YYYY-MM-DD";
	else if (sprache === "us")
		return "MM-DD-YYYY";
	else if (sprache === "gl")
		return "DD.MM.YYYY";
	else
		return "DD.MM.YYYY";
}

function getInputType(input)
{
	var container = $(input).closest(".bt-input-wrapper");
	
	if ($(container).hasClass("text-input"))
		return "text";
	else if ($(container).hasClass("mail-input"))
		return "mail";
	else if ($(container).hasClass("pwd-input"))
		return "password";
	else if ($(container).hasClass("cb-group"))
		return "checkbox";
	else if ($(container).hasClass("date-input"))
		return "date";
	else if ($(container).hasClass("cb-box"))
		return "combobox";
	else if ($(container).hasClass("num-input"))
		return "number";
}
